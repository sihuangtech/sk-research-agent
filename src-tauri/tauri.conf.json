{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Second Moon",
  "version": "0.9.0",
  "identifier": "cn.skstudio.agenticresearch",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run desktop:before-dev",
    "beforeBuildCommand": "npm run desktop:prepare"
  },
  "app": {
    "windows": [
      {
        "title": "Second Moon",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* blob:; img-src 'self' data: blob:; frame-src blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/research-node"
    ],
    "resources": { "runtime/": "runtime/" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
